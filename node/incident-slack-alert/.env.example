# Copy to .env and fill in. Never commit .env.
AVEECARE_API_KEY=ak_...
# Optional: only to point at a sandbox. Defaults to https://api.aveecare.com
# AVEECARE_BASE_URL=

# A Slack incoming webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# Optional
# POLL_INTERVAL_SECONDS=60     seconds between checks (minimum 15)
# MIN_SEVERITY=Low             Low, Medium, High or Critical
# INCLUDE_DETAILS=false        true adds each incident's title to the Slack message
# STATE_FILE=.incident-alert-state.json
